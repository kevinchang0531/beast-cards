rules_version = '2';
// 數學雷電線上排行榜：任何人都能讀排行、新增自己的分數；不能修改或刪除（老師要刪改請到 Firebase 主控台）
// scores 是正式排行榜；scores_test 給自動測試用，規則相同
// 同一個 Firebase 專案也放「靈獸卡牌對戰」的線上房間 tcg_rooms
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'score', 'mode', 'acc', 'stage', 'created'])
        && d.keys().hasAll(['nickname', 'score', 'mode', 'acc', 'stage', 'created'])
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 8
        && d.score is int && d.score >= 0 && d.score <= 10000000
        && d.mode in [1, 2, 3]
        && d.acc is int && d.acc >= 0 && d.acc <= 100
        && d.stage is int && d.stage >= 1 && d.stage <= 99
        && d.created is timestamp
        && d.created > request.time - duration.value(10, 'm')
        && d.created < request.time + duration.value(10, 'm');
    }
    match /scores/{id} {
      allow read: if true;
      allow create: if validScore();
      allow update, delete: if false;
    }
    match /scores_test/{id} {
      allow read: if true;
      allow create: if validScore();
      allow update, delete: if false;
    }
    // ---- 靈獸卡牌對戰（Godot遊戲/寶可夢卡牌）線上房間 ----
    // tcg_rooms/{房號}：房主建立（guest 空、status wait）；對手只能填 guest、guest_deck、status=play 一次
    // tcg_rooms/{房號}/actions/{0000}：雙方輪流寫入動作，只能新增、不能改刪
    function validRoom() {
      let d = request.resource.data;
      return d.keys().hasOnly(['host', 'host_deck', 'guest', 'guest_deck', 'seed', 'status', 'created'])
        && d.keys().hasAll(['host', 'host_deck', 'guest', 'guest_deck', 'seed', 'status', 'created'])
        && d.host is string && d.host.size() >= 1 && d.host.size() <= 12
        && d.host_deck is string && d.host_deck.size() <= 800
        && d.guest == '' && d.guest_deck == '' && d.status == 'wait'
        && d.seed is int
        && d.created is timestamp
        && d.created > request.time - duration.value(10, 'm')
        && d.created < request.time + duration.value(10, 'm');
    }
    match /tcg_rooms/{code} {
      allow read: if true;
      allow create: if code.matches('^[A-Z0-9]{6}$') && validRoom();
      allow update: if resource.data.guest == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guest_deck', 'status'])
        && request.resource.data.guest is string
        && request.resource.data.guest.size() >= 1 && request.resource.data.guest.size() <= 12
        && request.resource.data.guest_deck is string && request.resource.data.guest_deck.size() <= 800
        && request.resource.data.status == 'play';
      allow delete: if false;
      match /actions/{n} {
        allow read: if true;
        allow create: if n.matches('^[0-9]{4}$')
          && request.resource.data.keys().hasOnly(['by', 'a'])
          && request.resource.data.by in [0, 1]
          && request.resource.data.a is string && request.resource.data.a.size() <= 200;
        allow update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
